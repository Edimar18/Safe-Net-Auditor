<?xml version="1.0" encoding="utf-8"?>
<!--
  USB device filter for Safe-Net Auditor.
  Covers the most common ESP32 USB-serial bridge chips:
    • CH340 / CH341  (most cheap dev boards)
    • CP2102 / CP2104 (Espressif official)
    • FTDI FT232     (some clones)

  Place this file at:
    android/app/src/main/res/xml/usb_device_filter.xml

  Reference it in AndroidManifest.xml intent-filter (see CHANGES.md).
-->
<resources>
  <!-- CH340 / CH341 (VID 0x1A86) -->
  <usb-device vendor-id="6790" />

  <!-- CP2102 / CP2104 (VID 0x10C4, Silicon Labs) -->
  <usb-device vendor-id="4292" />

  <!-- FTDI FT232 (VID 0x0403) -->
  <usb-device vendor-id="1027" />

  <!-- Espressif built-in USB (ESP32-S2/S3, VID 0x303A) -->
  <usb-device vendor-id="12346" />
</resources>
